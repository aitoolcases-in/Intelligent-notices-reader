# Copy this file to .env and fill it in.

# --- Owner login (you) ---
OWNER_NAME=Your Name
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-this-pin-or-password

# --- Help desk ---
OFFICE_NAME=Accrevise
OFFICE_EMAIL=info@yourfirm.in   # official address: technical questions from the help desk are sent here

# --- Email (SMTP). Gmail: turn on 2-step verification, then create an App Password ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=
MAIL_FROM=Accrevise Office <you@example.com>

# --- Evening plan (India time) ---
REVIEW_TIME=18:30          # you get the drafted emails to approve
AUTO_SEND_TIME=            # optional, e.g. 21:30: send anyway if you haven't approved
WORK_DAYS=1,2,3,4,5,6      # Mon–Sat; Sunday = 0

# --- Server ---
PORT=3000
APP_URL=http://localhost:3000   # the address people open, e.g. https://desk.yourfirm.in
DATA_DIR=./data
